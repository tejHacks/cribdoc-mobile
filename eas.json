{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "CRIBDOC_ANDROID_ARCHS": "arm64-v8a,x86_64" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "CRIBDOC_ANDROID_ARCHS": "arm64-v8a" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "CRIBDOC_ANDROID_ARCHS": "arm64-v8a" }
    }
  }
}
